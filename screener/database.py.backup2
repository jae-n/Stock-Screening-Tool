"""Database singleton: owns the SQLite connection and all SQL."""

import json
import sqlite3
from contextlib import contextmanager
from datetime import datetime, timezone
from pathlib import Path

from screener.config import Config
from screener.singleton import SingletonMeta

SCHEMA = """
CREATE TABLE IF NOT EXISTS companies (
    ticker  TEXT PRIMARY KEY,
    cik     INTEGER NOT NULL,
    name    TEXT,
    updated TEXT
);
CREATE TABLE IF NOT EXISTS fundamentals (
    ticker      TEXT NOT NULL,
    metric      TEXT NOT NULL,
    period_type TEXT NOT NULL,      -- 'annual' or 'quarterly'
    period_end  TEXT NOT NULL,      -- YYYY-MM-DD
    value       REAL,
    unit        TEXT,
    form        TEXT,
    filed       TEXT,
    fy          INTEGER,
    fp          TEXT,
    PRIMARY KEY (ticker, metric, period_type, period_end)
);
CREATE INDEX IF NOT EXISTS idx_fund_ticker ON fundamentals (ticker, period_type);

CREATE TABLE IF NOT EXISTS screen_runs (     -- one row per morning message actually sent
    run_date TEXT PRIMARY KEY,               -- YYYY-MM-DD
    passers  TEXT NOT NULL,                  -- JSON list of tickers that passed every gate
    sent_at  TEXT
);
CREATE TABLE IF NOT EXISTS universe (        -- tickers found by Yahoo's screens
    ticker     TEXT PRIMARY KEY,
    sources    TEXT,                         -- comma-separated screens that listed it
    first_seen TEXT,                         -- YYYY-MM-DD
    last_seen  TEXT
);
CREATE TABLE IF NOT EXISTS discovery_state (
    state_key TEXT PRIMARY KEY,
    state_value TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS market_snapshot ( -- broad market overview, one per refresh
    snap_date TEXT PRIMARY KEY,
    payload   TEXT NOT NULL                  -- JSON
);
CREATE TABLE IF NOT EXISTS fundamentals_pit (  -- every filed version (for backtests)
    ticker      TEXT NOT NULL,
    metric      TEXT NOT NULL,
    period_type TEXT NOT NULL,
    period_end  TEXT NOT NULL,
    filed       TEXT NOT NULL,
    value       REAL,
    unit        TEXT,
    fp          TEXT,
    PRIMARY KEY (ticker, metric, period_type, period_end, filed)
);
CREATE TABLE IF NOT EXISTS backtest_prices (   -- long monthly history, both close flavours
    ticker    TEXT NOT NULL,
    month     TEXT NOT NULL,
    close     REAL,                            -- split-adjusted (valuation)
    adj_close REAL,                            -- split + dividend adjusted (returns)
    PRIMARY KEY (ticker, month)
);
CREATE TABLE IF NOT EXISTS backtest_price_meta (ticker TEXT PRIMARY KEY, updated TEXT);
CREATE TABLE IF NOT EXISTS market_data (
    ticker             TEXT PRIMARY KEY,
    price              REAL,
    market_cap         REAL,
    shares_outstanding REAL,
    forward_eps        REAL,
    sector             TEXT,
    industry           TEXT,
    updated            TEXT
);
CREATE TABLE IF NOT EXISTS prices (          -- month-end closes, split-adjusted only
    ticker TEXT NOT NULL,
    month  TEXT NOT NULL,                    -- YYYY-MM
    close  REAL,
    PRIMARY KEY (ticker, month)
);
CREATE TABLE IF NOT EXISTS splits (
    ticker TEXT NOT NULL,
    date   TEXT NOT NULL,                    -- YYYY-MM-DD
    ratio  REAL NOT NULL,                    -- 4.0 = 4-for-1
    PRIMARY KEY (ticker, date)
);
"""

MARKET_COLUMNS = ("price", "market_cap", "shares_outstanding", "forward_eps", "sector", "industry")


class Database(metaclass=SingletonMeta):
    def __init__(self):
        self._config = Config()
        self._conn = None
        self.as_of = None            # 'YYYY-MM-DD': see as_of_date()
        self._pit_cache = {}

    @property
    def conn(self):
        """Lazy connection, so Config can be changed before first use."""
        if self._conn is None:
            path = Path(self._config.db_path)
            path.parent.mkdir(parents=True, exist_ok=True)
            self._conn = sqlite3.connect(path)
            self._conn.executescript(SCHEMA)
        return self._conn

    @staticmethod
    def _now():
        return datetime.now(timezone.utc).isoformat(timespec="seconds")

    # ---- fundamentals -------------------------------------------------------
    def store_company(self, ticker, cik, name, rows, pit_rows=None):
        """Upsert a company and its fundamentals rows (tuples from FactsParser.to_rows)."""
        with self.conn:
            self.conn.execute(
                "INSERT OR REPLACE INTO companies (ticker, cik, name, updated) VALUES (?,?,?,?)",
                (ticker, cik, name, self._now()),
            )
            self.conn.executemany(
                "INSERT OR REPLACE INTO fundamentals "
                "(ticker, metric, period_type, period_end, value, unit, form, filed, fy, fp) "
                "VALUES (?,?,?,?,?,?,?,?,?,?)",
                rows,
            )
            if pit_rows:
                self.conn.executemany(
                    "INSERT OR REPLACE INTO fundamentals_pit "
                    "(ticker, metric, period_type, period_end, filed, value, unit, fp) "
                    "VALUES (?,?,?,?,?,?,?,?)", pit_rows)
                self._pit_cache.pop(ticker, None)
        return len(rows)

    def annual_rows(self, ticker):
        """Return {metric: {period_end: (value, filed_date)}} for annual data."""
        if self.as_of:
            return {m: {e: (v, f) for e, (v, f, _fp) in series.items()}
                    for m, series in self._pit_rows(ticker, "annual").items()}
        rows = self.conn.execute(
            "SELECT metric, period_end, value, filed FROM fundamentals "
            "WHERE ticker=? AND period_type='annual' ORDER BY period_end",
            (ticker,),
        ).fetchall()
        data = {}
        for metric, end, value, filed in rows:
            data.setdefault(metric, {})[end] = (value, filed)
        return data

    def period_rows(self, ticker, period_type):
        """Return {metric: {period_end: (value, filed, fp)}} for 'quarterly' or 'ytd' rows."""
        if self.as_of:
            return self._pit_rows(ticker, period_type)
        rows = self.conn.execute(
            "SELECT metric, period_end, value, filed, fp FROM fundamentals "
            "WHERE ticker=? AND period_type=? ORDER BY period_end",
            (ticker, period_type),
        ).fetchall()
        data = {}
        for metric, end, value, filed, fp in rows:
            data.setdefault(metric, {})[end] = (value, filed, fp)
        return data

    def annual_series(self, ticker):
        """Return {metric: {period_end: value}} for annual data, oldest to newest."""
        return {m: {e: v for e, (v, _f) in series.items()}
                for m, series in self.annual_rows(ticker).items()}

    # ---- market data --------------------------------------------------------
    def store_market(self, ticker, snapshot, closes, splits):
        """snapshot: dict with MARKET_COLUMNS keys; closes: [(YYYY-MM, close)];
        splits: [(YYYY-MM-DD, ratio)]."""
        values = [snapshot.get(c) for c in MARKET_COLUMNS]
        with self.conn:
            self.conn.execute(
                "INSERT OR REPLACE INTO market_data "
                "(ticker, price, market_cap, shares_outstanding, forward_eps, sector, industry, updated) "
                "VALUES (?,?,?,?,?,?,?,?)",
                (ticker, *values, self._now()),
            )
            self.conn.executemany(
                "INSERT OR REPLACE INTO prices (ticker, month, close) VALUES (?,?,?)",
                [(ticker, m, c) for m, c in closes],
            )
            self.conn.execute("DELETE FROM splits WHERE ticker=?", (ticker,))
            self.conn.executemany(
                "INSERT INTO splits (ticker, date, ratio) VALUES (?,?,?)",
                [(ticker, d, r) for d, r in splits],
            )

    def get_market(self, ticker):
        if self.as_of:
            return self._market_as_of(ticker)
        row = self.conn.execute(
            f"SELECT {', '.join(MARKET_COLUMNS)} FROM market_data WHERE ticker=?", (ticker,)
        ).fetchone()
        return dict(zip(MARKET_COLUMNS, row)) if row else None

    def get_closes(self, ticker):
        if self.as_of:                      # never show a price from after the as-of month
            return {m: c for m, c in self.long_closes(ticker).items() if m <= self.as_of[:7]}
        rows = self.conn.execute("SELECT month, close FROM prices WHERE ticker=?", (ticker,))
        return dict(rows.fetchall())

    def get_splits(self, ticker):
        return self.conn.execute(
            "SELECT date, ratio FROM splits WHERE ticker=? ORDER BY date", (ticker,)
        ).fetchall()

    def split_factor_after(self, ticker, filed):
        """Product of split ratios dated after `filed`. Per-share numbers reported in a
        filing are on the share basis of that filing date; multiply today's split-adjusted
        price by this factor to put it on the same basis (divide EPS by it to go the
        other way)."""
        factor = 1.0
        if filed:
            for date, ratio in self.get_splits(ticker):
                if date > filed:
                    factor *= ratio
        return factor

    def tickers_in_sector(self, sector):
        rows = self.conn.execute("SELECT ticker FROM market_data WHERE sector=?", (sector,))
        return [r[0] for r in rows.fetchall()]

    # ---- discovery universe & market overview ---------------------------------
    def upsert_universe(self, ticker, sources, seen_date):
        """Save a ticker without duplicating its discovery-source labels."""
        with self.conn:
            row = self.conn.execute(
                "SELECT sources FROM universe WHERE ticker = ?",
                (ticker,),
            ).fetchone()

            labels = set()
            if row and row[0]:
                labels.update(x for x in row[0].split(",") if x)
            labels.update(x for x in sources.split(",") if x)
            combined = ",".join(sorted(labels))

            self.conn.execute(
                """
                INSERT INTO universe (ticker, sources, first_seen, last_seen)
                VALUES (?, ?, ?, ?)
                ON CONFLICT(ticker) DO UPDATE SET
                    sources = excluded.sources,
                    last_seen = excluded.last_seen
                """,
                (ticker, combined, seen_date, seen_date),
            )

    def universe_since(self, cutoff):
        """[(ticker, sources)] for tickers Yahoo listed on or after `cutoff` (YYYY-MM-DD)."""
        return self.conn.execute(
            "SELECT ticker, sources FROM universe WHERE last_seen >= ? ORDER BY ticker", (cutoff,)
        ).fetchall()

    def save_overview(self, snap_date, payload):
        with self.conn:
            self.conn.execute(
                "INSERT OR REPLACE INTO market_snapshot (snap_date, payload) VALUES (?,?)",
                (snap_date, json.dumps(payload)),
            )

    def latest_overview(self):
        row = self.conn.execute(
            "SELECT payload FROM market_snapshot ORDER BY snap_date DESC LIMIT 1"
        ).fetchone()
        return json.loads(row[0]) if row else None

    # ---- point-in-time access (backtests) -------------------------------------
    @contextmanager
    def as_of_date(self, iso_date):
        """Inside this block every reader (annual_rows, period_rows, get_market, get_closes) sees
        the world as it was on `iso_date`: only filings made by then, only prices up to then.
        The screening code runs unchanged, which is the point: it is tested exactly as it runs live."""
        previous, self.as_of = self.as_of, iso_date
        try:
            yield
        finally:
            self.as_of = previous

    def _pit_rows(self, ticker, period_type):
        """{metric: {period_end: (value, filed, fp)}} using the latest version filed on or before as_of."""
        if ticker not in self._pit_cache:
            self._pit_cache[ticker] = self.conn.execute(
                "SELECT metric, period_type, period_end, filed, value, fp FROM fundamentals_pit "
                "WHERE ticker=? ORDER BY filed", (ticker,)).fetchall()
        data = {}
        for metric, ptype, end, filed, value, fp in self._pit_cache[ticker]:
            if filed > self.as_of:
                break                        # rows are sorted by filing date
            if ptype == period_type:
                data.setdefault(metric, {})[end] = (value, filed, fp)   # later filings overwrite earlier
        return data

    def _market_as_of(self, ticker):
        price = self.long_closes(ticker).get(self.as_of[:7])
        if not price:
            return None
        meta = self.conn.execute("SELECT sector, industry FROM market_data WHERE ticker=?", (ticker,)).fetchone()
        shares = mcap = None
        rows = self.annual_rows(ticker).get("shares_diluted")
        if rows:
            value, filed = rows[max(rows)]
            shares = value * self.split_factor_after(ticker, filed)   # onto today's share basis, like the price
            mcap = price * shares
        return {"price": price, "market_cap": mcap, "shares_outstanding": shares, "forward_eps": None,
                "sector": meta[0] if meta else None, "industry": meta[1] if meta else None}

    def has_pit(self, ticker):
        return self.conn.execute("SELECT 1 FROM fundamentals_pit WHERE ticker=? LIMIT 1", (ticker,)).fetchone() is not None

    def store_backtest_prices(self, ticker, rows):
        """rows: [(YYYY-MM, close, adj_close)]"""
        with self.conn:
            self.conn.executemany(
                "INSERT OR REPLACE INTO backtest_prices (ticker, month, close, adj_close) VALUES (?,?,?,?)",
                [(ticker, m, c, a) for m, c, a in rows])
            self.conn.execute("INSERT OR REPLACE INTO backtest_price_meta (ticker, updated) VALUES (?,?)",
                              (ticker, self._now()))

    def backtest_price_age_days(self, ticker):
        return self._age_days("backtest_price_meta", ticker)

    def long_closes(self, ticker):
        return dict(self.conn.execute("SELECT month, close FROM backtest_prices WHERE ticker=?", (ticker,)).fetchall())

    def adj_closes(self, ticker):
        return dict(self.conn.execute("SELECT month, adj_close FROM backtest_prices WHERE ticker=?", (ticker,)).fetchall())

    # ---- daily runs & data freshness ----------------------------------------
    def save_run(self, run_date, passers, sent_at):
        with self.conn:
            self.conn.execute(
                "INSERT OR REPLACE INTO screen_runs (run_date, passers, sent_at) VALUES (?,?,?)",
                (run_date, json.dumps(passers), sent_at),
            )

    def get_run(self, run_date):
        row = self.conn.execute(
            "SELECT passers, sent_at FROM screen_runs WHERE run_date=?", (run_date,)
        ).fetchone()
        return {"passers": json.loads(row[0]), "sent_at": row[1]} if row else None

    def latest_run_before(self, run_date):
        """Tickers that passed in the most recent message sent before `run_date`, or None."""
        row = self.conn.execute(
            "SELECT passers FROM screen_runs WHERE run_date < ? AND sent_at IS NOT NULL "
            "ORDER BY run_date DESC LIMIT 1", (run_date,)
        ).fetchone()
        return json.loads(row[0]) if row else None

    def _age_days(self, table, ticker):
        row = self.conn.execute(f"SELECT updated FROM {table} WHERE ticker=?", (ticker,)).fetchone()
        if not row or not row[0]:
            return None
        stamp = datetime.fromisoformat(row[0])
        if stamp.tzinfo is None:
            stamp = stamp.replace(tzinfo=timezone.utc)
        return (datetime.now(timezone.utc) - stamp).total_seconds() / 86400

    def has_company(self, ticker):
        return self.conn.execute("SELECT 1 FROM companies WHERE ticker=?", (ticker,)).fetchone() is not None

    def company_age_days(self, ticker):
        return self._age_days("companies", ticker)

    def market_age_days(self, ticker):
        return self._age_days("market_data", ticker)

    def close(self):
        if self._conn is not None:
            self._conn.close()
            self._conn = None
    # ---- discovery batch progress ------------------------------------------
    
    def get_discovery_position(self):
        row = self.conn.execute(
            "SELECT state_value FROM discovery_state WHERE state_key = ?",
            ("position",),
        ).fetchone()
        return int(row[0]) if row else 0

    def set_discovery_position(self, position):
        with self.conn:
            self.conn.execute(
                "INSERT OR REPLACE INTO discovery_state (state_key, state_value) "
                "VALUES (?, ?)",
                ("position", str(position)),
            )
